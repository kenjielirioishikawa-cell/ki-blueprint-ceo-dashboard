{
  "name": "ki-blueprint-ceo-dashboard",
  "version": "1.0.0",
  "description": "KI BLUEPRINT™ CEO Manager — Operating Dashboard with real-time updates",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "seed": "node server/seed.js"
  },
  "keywords": ["dashboard", "ceo", "management", "real-time"],
  "author": "KI BLUEPRINT",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
